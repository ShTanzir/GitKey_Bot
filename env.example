# =========================================================
# GitKey Bot - Environment Variables Template
# Copy this file to .env and configure your values.
# NEVER commit your real .env file or TELEGRAM_BOT_TOKEN to git!
# =========================================================

# Required: Telegram Bot Token obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=8978827490:AAHx-j0RtXEyDzjs0wsdySC9Br2_UUXggyA

# Optional: Server Port (Defaults to 8080 for Render / Heroku / Container)
PORT=8080

# Optional: Set to true if deploying with Webhooks instead of Polling
USE_WEBHOOK=false

# Optional: Your Render.com public service URL (Required only if USE_WEBHOOK=true)
# WEBHOOK_URL=https://gitkey-bot.onrender.com

# Optional: Security & Resource Limits
MAX_FILE_SIZE_MB=20
TEMP_FILE_LIFETIME_SEC=1800
RATE_LIMIT_ACTIONS_PER_MIN=30
